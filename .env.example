APP_NAME=document-extraction-api
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/document_api

STORAGE_BACKEND=local
STORAGE_PATH=./storage
DELETE_PHYSICAL_FILE=false

MAX_PDF_SIZE_MB=50
MAX_PDF_PAGES=500
UPLOAD_CHUNK_SIZE_BYTES=1048576

DEFAULT_EXTRACTION_ENGINE=auto
PDF_NATIVE_MIN_CHARS_PER_PAGE=80
PDF_NATIVE_MIN_WORDS_PER_PAGE=5
PDF_NATIVE_MAX_INVALID_CHAR_RATIO=0.10
PDF_NATIVE_MIN_TEXT_PAGE_RATIO=0.70
OCR_DPI=200
OCR_DEFAULT_LANGUAGE=por
OCR_MAX_CONCURRENCY=1
MAX_IMAGES_PER_DOCUMENT=500
IGNORE_REPEATED_IMAGES=true

EXTRACTION_WORKER_POLL_SECONDS=2
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_TIMEOUT_SECONDS=900
EXTRACTION_JOB_TTL_SECONDS=3600
EXTRACTION_CLEANUP_INTERVAL_SECONDS=60
EXTRACTION_SSE_HEARTBEAT_SECONDS=15
EXTRACTION_SSE_TIMEOUT_SECONDS=600

STRUCTURING_PROVIDER=openai
STRUCTURING_MODEL=gpt-5.6-sol
OPENAI_API_KEY=
STRUCTURING_TIMEOUT_SECONDS=120
STRUCTURING_MAX_ATTEMPTS=3
STRUCTURING_WORKER_POLL_SECONDS=2
ORDER_STRUCTURING_PROMPT_VERSION=1.0.0
ORDER_STRUCTURING_SCHEMA_VERSION=1.0.0
STRUCTURING_AUTO_APPROVE_MIN_CONFIDENCE=0.90

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-API-Key,X-Request-ID,Idempotency-Key
CORS_EXPOSE_HEADERS=X-Request-ID,Content-Disposition
CORS_MAX_AGE=3600
